  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RelicTrail.NPC.NPCDialogue
  npcName: The Canyon Explorer
  initialDialogue:
  - Phew! It's scorching out here. You made it past the forest!
  - The second relic fragment is sealed inside the ancient sandstone chamber ahead.
  - Step upon all three stone pressure plates before the entrance to unlock the chamber
    door!
  - Once all plates are pressed, the chamber opens to grant you the Canyon Relic.
  repeatDialogue:
  - Step on all three pressure plates (Left, Center, and Right) before the entrance.
  - Once all three are pressed down, the stone door slides open to reveal the Canyon
    Relic!
  lookAtDistance: 6
  rotationSpeed: 4
