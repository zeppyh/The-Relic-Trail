  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5a3e7e9700e891f4a8ebde737a532f88, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RelicTrail.NPC.NPCDialogue
  npcName: The Frozen Sage
  initialDialogue:
  - Traveler... your perilous journey nears its culmination.
  - The third fragment lies trapped beneath eternal glacial ice at the central altar.
  - Focus all three celestial crystals toward the central altar to channel their
    energy!
  - Press [E] on each crystal to focus its beam directly onto the altar and shatter
    the ice barrier.
  repeatDialogue:
  - Focus all three celestial crystals to direct their beams into the central altar.
  - Once all three converge, the ice barrier will shatter and release the Frozen
    Relic.
  lookAtDistance: 6
  rotationSpeed: 4
  npcAnimatorController: {fileID: 9100000, guid: a7c24f653198de4469e8023bf7410001, type: 2}
  npcAvatar: {fileID: 9000000, guid: ab7437c47894cb54d845cb3f2a83e3c0, type: 3}
